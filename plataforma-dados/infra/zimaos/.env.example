# Copie para .env e ajuste. Nunca versione o .env.

# Marca exibida no questionário e nas propostas
MARCA_NOME=Cardume

# Onde os dados ficam no ZimaOS (padrão do sistema para apps)
DADOS_HOST=/DATA/AppData/plataforma

# --- Servidor MCP ---------------------------------------------------------
MCP_PORTA_HOST=8787
# Token exigido em /mcp e /api (gere com: openssl rand -hex 32).
# Para o cliente responder o questionário, envie o link http://SEU_HOST:8787/?token=...
MCP_TOKEN=
# Hosts aceitos (proteção contra DNS rebinding). Ex.: zima.local:8787,192.168.0.10:8787,discovery.seudominio.com.br
MCP_HOSTS_PERMITIDOS=

# --- LLM dos agentes ------------------------------------------------------
# nenhum    = o servidor só monta o contexto; Claude (Desktop/Code) faz o raciocínio (recomendado)
# ollama    = modelo local na GPU
# anthropic = Claude pela API (preencha ANTHROPIC_API_KEY)
LLM_BACKEND=nenhum
MODELO_LOCAL=qwen3:4b
CONTEXTO_LOCAL=16384
MODELO_EMBEDDING=bge-m3
ANTHROPIC_API_KEY=
MODELO_ANTHROPIC=claude-opus-5-5
ESFORCO_ANTHROPIC=high

# --- Memória vetorial -----------------------------------------------------
QDRANT_API_KEY=

# --- Custos ---------------------------------------------------------------
CAMBIO_USD_BRL=5.50
TARIFA_KWH_BRL=0.90

# --- Perfil "dados" (PostgreSQL + Metabase) -------------------------------
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=
POSTGRES_DB=analytics
METABASE_PORTA_HOST=3000

# --- Perfil "automacao" (n8n) ---------------------------------------------
N8N_PORTA_HOST=5678
N8N_ENCRYPTION_KEY=

# --- Perfil "acesso" (Cloudflare Tunnel) ----------------------------------
CLOUDFLARE_TUNNEL_TOKEN=

# --- Perfil "monitor" -----------------------------------------------------
UPTIME_PORTA_HOST=3001
